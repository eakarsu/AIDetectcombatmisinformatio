NODE_ENV=development
DATABASE_URL=postgresql://factcheck_user:change-me@localhost:5432/factcheck_db
JWT_SECRET=replace-with-at-least-32-random-characters
BACKEND_PORT=4000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
OPENROUTER_API_KEY=
# Media stores, detector workers, fact-check networks, and case systems require approved adapters.
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
